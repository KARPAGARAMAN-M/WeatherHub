# WeatherHub Frontend Environment Variables Example

# OpenWeatherMap API Key (Required for live weather data)
# Get a free key at: https://home.openweathermap.org/users/sign_up
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Base API URL for backend API server.
# Leave blank (default) if using relative path /api (e.g., when hosted with Nginx proxy or Vite dev proxy).
# If frontend is hosted on Vercel/Netlify and backend is on Render/Railway, set this to backend URL:
# VITE_API_BASE_URL=https://weatherhub-backend.onrender.com
VITE_API_BASE_URL=
