# ========================
# Root-level .gitignore
# ========================

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ========================
# Frontend (React / Vite)
# ========================
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local
frontend/logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# ========================
# Backend (Spring Boot / Maven)
# ========================
backend/target/
backend/*.jar
backend/*.war
backend/*.class
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# Environment files
.env
frontend/.env
